
:root {
  --cyan: #38d9f5;
  --purple: #8872ff;
  --muted: #93a3bd;
  --border: #ffffff15;
  --panel: #111827;
}

.navbar {
  height: 76px;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 5%;
  background: #070b14e8;
  backdrop-filter: blur(22px);
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 23px;
  font-weight: 700;
  letter-spacing: -1px;
}

.brand svg, .brand span { color: var(--cyan); }

.nav-links {
  display: flex;
  gap: 28px;
  font-size: 13px;
  color: #a9b7ce;
}

.nav-links a {
  position: relative;
  transition: .25s;
}

.nav-links a:hover { color: var(--cyan); }

.nav-links a::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -9px;
  width: 0;
  height: 2px;
  background: var(--cyan);
  transition: width .3s;
}

.nav-links a:hover::after { width: 100%; }

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #9ba5b8;
}

.system-status i {
  width: 7px;
  height: 7px;
  background: #f87171;
  border-radius: 50%;
}

.system-status.online { color: #5eead4; }

.system-status.online i {
  background: #5eead4;
  animation: pulse 2s infinite;
}

main {
  max-width: 1500px;
  margin: auto;
  padding: 26px 5% 60px;
}

.hero {
  min-height: 540px;
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  border: 1px solid #6975ba40;
  border-radius: 28px;
  padding: 40px;
  background:
    radial-gradient(ellipse at 80% 40%, #203b6555, transparent 60%),
    linear-gradient(125deg, #0b111e, #171831);
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(#8ba7ff07 1px, transparent 1px),
    linear-gradient(90deg, #8ba7ff07 1px, transparent 1px);
  background-size: 45px 45px;
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: #4c43e72b;
  filter: blur(90px);
  right: 0;
  top: 0;
  animation: drift 8s ease-in-out infinite alternate;
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.eyebrow {
  font-family: 'Space Grotesk', monospace;
  color: var(--cyan);
  font-size: 11px;
  letter-spacing: 2.5px;
  font-weight: 600;
}

h1, h2, h3 {
  font-family: 'Space Grotesk', sans-serif;
}

h1 {
  font-size: clamp(42px, 4.7vw, 76px);
  letter-spacing: -3px;
  line-height: 1.03;
  margin: 22px 0;
}

h1 span {
  display: block;
  background: linear-gradient(100deg, #a6b6ff, #22d3ee, #8b5cf6);
  background-size: 200%;
  color: transparent;
  background-clip: text;
  animation: gradient 6s ease infinite;
}

.hero-content p {
  max-width: 500px;
  line-height: 1.9;
  color: #a9b7ce;
  font-size: 15px;
}

.controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
}

button, .cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 16px;
  border: 1px solid #7586c044;
  border-radius: 10px;
  background: #182136;
  color: #e7edff;
  font-size: 13px;
  transition: transform .2s, background .2s, border-color .2s;
}

button:hover, .cta:hover {
  transform: translateY(-2px);
  border-color: var(--cyan);
  background: #20334a;
}

button svg, .cta svg { width: 18px; }

.primary {
  background: linear-gradient(120deg, #5345d6, #7655e8);
  border-color: #9582ff;
  color: white;
}

.secondary { background: #ffffff08; }

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 30px;
}

.hero-tags span {
  color: #9baac2;
  font-size: 10px;
  text-transform: uppercase;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 7px 12px;
}

.robot-container {
  position: relative;
  min-width: 0;
  text-align: center;
}

.robot-status {
  display: flex;
  justify-content: space-between;
  color: var(--cyan);
  font-size: 10px;
  letter-spacing: 1px;
}

.robot-canvas {
  height: 350px;
  position: relative;
  background: radial-gradient(circle, #197da422, transparent 65%);
}

.robot-letter {
  position: absolute;
  right: 10px;
  top: 25px;
  font-size: 48px;
  color: var(--cyan);
  font-family: 'Space Grotesk';
  z-index: 2;
  pointer-events: none;
}

.spelling {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 15px;
}

.spelling span {
  color: #68768e;
  font-size: 25px;
  font-weight: 700;
  transition: .3s;
}

.spelling .active {
  color: var(--cyan);
  text-shadow: 0 0 20px #22d3ee88;
  transform: scale(1.25);
}

.word-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 7px;
}

.word-options button {
  font-size: 11px;
  padding: 8px 12px;
}

.selected {
  background: #15506b !important;
  border-color: var(--cyan) !important;
  color: var(--cyan) !important;
}

.robot-hint {
  color: #8d9bb8;
  font-size: 9px;
  letter-spacing: 2px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 20px;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 22px;
  background: linear-gradient(145deg, #151d2e, #0d1420);
  border: 1px solid var(--border);
  border-radius: 16px;
  transition: .3s;
}

.stat-card:hover {
  transform: translateY(-5px);
  border-color: #38d9f566;
}

.stat-card svg { color: var(--cyan); }

.stat-card strong {
  font-family: 'Space Grotesk';
  font-size: 32px;
}

.stat-card span {
  color: var(--muted);
  font-size: 12px;
}

.section { margin-top: 48px; }

.section h2 {
  font-size: 30px;
  letter-spacing: -1px;
  margin: 10px 0 16px;
}

.muted {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.panel {
  padding: 22px;
  background: linear-gradient(145deg, #141c2d, #0d1420);
  border: 1px solid var(--border);
  border-radius: 18px;
  min-width: 0;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 13px;
  margin-bottom: 14px;
}

.gesture-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 10px;
}

.gesture-card {
  padding: 8px;
  background: #121a2b;
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
  transition: .25s;
}

.gesture-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
}

.gesture-card img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: contain;
  background: #090e19;
  border-radius: 8px;
}

.gesture-card strong {
  display: block;
  margin-top: 8px;
  color: var(--cyan);
}

.translator-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 18px;
}

.camera-frame {
  width: 100%;
  height: 340px;
  background: #050912;
  border: 1px solid #38d9f533;
  border-radius: 14px;
  overflow: hidden;
  position: relative;
}

.camera-frame video {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.camera-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8293ad;
}

.camera-placeholder svg { color: var(--cyan); }

.tracking-preview {
  position: absolute;
  bottom: 10px;
  right: 10px;
  width: 43%;
  border: 1px solid var(--cyan);
  border-radius: 8px;
  background: #050912;
}

.status {
  color: var(--cyan);
  font-size: 10px;
}

.toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
  color: var(--muted);
  font-size: 12px;
}

.toggle input { accent-color: #7655ff; }

.detected-letter {
  text-align: center;
  font-family: 'Space Grotesk';
  font-size: 85px;
  font-weight: 700;
  color: var(--cyan);
  text-shadow: 0 0 30px #22d3ee44;
}

.progress {
  height: 7px;
  background: #253047;
  border-radius: 20px;
  overflow: hidden;
}

.progress div {
  height: 100%;
  background: linear-gradient(90deg, #7655ff, #22d3ee);
  border-radius: 20px;
  transition: width .3s;
}

.word-box {
  background: #090f1d;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  margin-top: 16px;
  overflow-wrap: anywhere;
}

.word-box small {
  font-size: 10px;
  color: var(--muted);
  letter-spacing: 1.5px;
}

.word-box h3, .word-box p {
  margin: 10px 0 0;
}

.word-box h3 { color: var(--cyan); }

.learn-grid, .analytics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.challenge {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 14px;
}

.challenge img {
  width: 180px;
  height: 180px;
  object-fit: contain;
  border-radius: 12px;
}

.challenge a {
  font-size: 12px;
  color: var(--cyan);
}

.alphabet-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}

.alphabet-grid button {
  aspect-ratio: 1;
  font-size: 20px;
}

.metric-row { margin: 24px 0; }

.matrix {
  width: 100%;
  border-radius: 10px;
}

.pipeline {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 24px 0;
}

.pipeline span {
  padding: 12px 18px;
  border: 1px solid #38d9f544;
  background: #22d3ee0b;
  border-radius: 10px;
  color: var(--cyan);
  font-size: 12px;
}

.error {
  color: #fca5a5;
  font-size: 12px;
}

footer {
  border-top: 1px solid var(--border);
  text-align: center;
  padding: 35px;
  color: var(--muted);
  font-size: 12px;
}

footer .brand { justify-content: center; }

@keyframes pulse {
  50% { box-shadow: 0 0 0 6px #5eead420; }
}

@keyframes drift {
  to { transform: translate(-100px, 70px); }
}

@keyframes gradient {
  50% { background-position: 100% 50%; }
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 25px;
  }

  .nav-links { gap: 12px; }
  .system-status { display: none; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .gesture-grid { grid-template-columns: repeat(4, 1fr); }

  .translator-grid,
  .learn-grid,
  .analytics-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 550px) {
  .navbar {
    height: auto;
    padding: 15px;
    flex-wrap: wrap;
  }

  .nav-links {
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }

  main { padding: 15px; }
  h1 { font-size: 42px; }
  .hero { padding: 20px; }
  .robot-canvas { height: 300px; }
  .camera-frame { height: 260px; }
  .stat-card strong { font-size: 26px; }
  .alphabet-grid { grid-template-columns: repeat(4, 1fr); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
